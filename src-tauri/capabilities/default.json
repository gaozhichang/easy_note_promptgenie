{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "快捷记事本主窗口权限",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-destroy",
    "dialog:default",
    "dialog:allow-open",
    "clipboard-manager:allow-write-text"
  ]
}
