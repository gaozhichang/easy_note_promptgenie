{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "快捷记事本",
  "version": "0.1.0",
  "identifier": "com.gaozhichang.quicknote",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "快捷记事本",
        "width": 1080,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "轻量、即开即用的本地记事本",
    "longDescription": "快捷记事本是一款轻量的本地 Markdown 记事本：左侧笔记列表按修改时间排序，正文第一行即标题，笔记保存在你自己选择的目录中。",
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
